# Copy this file to .env for local development: cp .env.example .env
# These two values come from your Supabase project:
#   Project Settings -> API -> Project URL / Project API keys (anon public)
#
# Vite only exposes variables prefixed with VITE_ to the browser. The anon key
# is designed to be public — it grants only what the row-level security policies
# in supabase/migrations allow.
#
# Leave both blank to run with the localStorage fallback instead (votes then
# stay on your own machine, which is the old behaviour).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
